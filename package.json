    "test:api": "node scripts/verify-public-api.mjs",
    "test:network:guards": "node scripts/verify-network-guards.mjs",
    "test:server:rooms": "node scripts/verify-server-rooms.mjs",
    "test:server:runtime": "node scripts/verify-server-runtime.mjs",
